# Local WSL CLI. Copy this file to .env and adjust the service/model values below.
PI_PROVIDER=local
PI_BASE_URL=http://127.0.0.1:8080/v1
# Blank discovers the current service model on each run; choose an ID if /models lists several.
PI_MODEL=
# Dummy value for local endpoints without authentication. Replace it if your endpoint requires a key.
PI_API_KEY=local
# Conservative generic values; set these to values supported by the configured service/model.
PI_CONTEXT_WINDOW=32768
PI_MAX_TOKENS=4096
PI_REASONING=false
PI_SUPPORTS_REASONING_EFFORT=false
PI_TASK_ISOLATION=local

# CPU-only local speech recognition; ASR_MODEL may also be a local CTranslate2 model directory.
ASR_BACKEND=faster-whisper
ASR_MODEL=small
ASR_LANGUAGE=zh
ASR_VAD_FILTER=true
FASTER_WHISPER_DOWNLOAD_ROOT=.tooling/wsl/cache/asr

# Media-work limits: five hours, 1 GiB per download, 10 GiB under the selected runs root.
# All values are positive integers. Symlinks are excluded; hard links count once.
MEDIA_MAX_DURATION_SECONDS=18000
MEDIA_MAX_FILE_BYTES=1073741824
MEDIA_MAX_DISK_BYTES=10737418240
